namespace Mc2it.Agicap.Suppliers;

using System.Net.Http.Json;

/// <summary>
/// Manages the suppliers of the entity with the specified identifier.
/// </summary>
/// <param name="client">The Agicap API client.</param>
/// <param name="entityId">The entity identifier.</param>
public class SupplierApi(Client client, int entityId) {

	/// <summary>
	/// The relative URI of the API endpoint.
	/// </summary>
	private readonly string requestUri = $"suppliers/v1/entities/{entityId}";

	/// <summary>
	/// The API client for the supplier synchronization.
	/// </summary>
	// TODO public SupplierSynchronizationApi Synchronization => new(client, entityId);

	/// <summary>
	/// Fetches all suppliers.
	/// </summary>
	/// <param name="cancellationToken">The token to cancel the operation.</param>
	/// <returns>The supplier list.</returns>
	public CursorPaginatedList<Supplier> ReadAll(CancellationToken cancellationToken = default) =>
		ReadAllAsync(cancellationToken).GetAwaiter().GetResult();

	/// <summary>
	/// Fetches all suppliers.
	/// </summary>
	/// <param name="cancellationToken">The token to cancel the operation.</param>
	/// <returns>The supplier list.</returns>
	public async Task<CursorPaginatedList<Supplier>> ReadAllAsync(CancellationToken cancellationToken = default) =>
		await client.GetAsync<CursorPaginatedList<Supplier>>(requestUri, cancellationToken: cancellationToken);
}
