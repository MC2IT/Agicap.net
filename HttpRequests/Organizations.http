### Connects to Agicap API with an authenticated account.
# @name auth
POST {{baseUrl}}/auth/v1/token
Accept: application/json
Content-Type: application/x-www-form-urlencoded

client_id={{$processEnv %clientId}}
&client_secret={{$processEnv %clientSecret}}
&grant_type=client_credentials
&scope=agicap:public-api

### Fetches all organizations.
GET {{baseUrl}}/organizations/v1
Accept: application/json
Authorization: Bearer {{auth.response.body.access_token}}

### Fetches all entities of the specified organization.
GET {{baseUrl}}/organizations/v1/{{$processEnv %organization}}/entities
Accept: application/json
Authorization: Bearer {{auth.response.body.access_token}}
