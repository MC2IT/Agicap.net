### Generates a new access token.
# @name auth
POST {{baseUrl}}/auth/v1/token
Accept: application/json
Content-Type: application/x-www-form-urlencoded

client_id={{$processEnv %clientId}}
&client_secret={{$processEnv %clientSecret}}
&grant_type=client_credentials
&scope=agicap:public-api public-api:manage-payment-beneficiaries

### Fetches all beneficiaries.
GET {{baseUrl}}/payments/v2/entities/{{$processEnv %entity}}/Beneficiaries
Accept: application/json
Authorization: Bearer {{auth.response.body.access_token}}
